diff --git a/iokit/Kernel/arm/SweetFairPlay.cpp b/iokit/Kernel/arm/SweetFairPlay.cpp
new file mode 100644
index 0000000..7f03077
--- /dev/null
+++ b/iokit/Kernel/arm/SweetFairPlay.cpp
@@ -0,0 +1,97 @@
+/*
+ * umi/sweet: a stand-in for com.apple.driver.FairPlayIOKit.
+ *
+ * fairplayd.H2 (launchd KeepAlive, MachServices com.apple.fairplayd, .versioned and
+ * com.apple.unfreed = host special port 17) looks up IOProviderClass
+ * "com_apple_driver_FairPlayIOKit" at launch and exits when there is none, so launchd
+ * restarts it forever (59 times in one 0154 boot). Requests to its ports then stay queued
+ * with launchd: locationd blocks in a FairPlay MIG call (msgh_id 1203) and wifid in a
+ * synchronous CoreLocation call behind it, so wifid never sets up a Wi-Fi device.
+ *
+ * This service has the class name fairplayd matches and a user client that opens; every
+ * external method is logged (first 200: selector, scalar / struct sizes) and refused with
+ * kIOReturnUnsupported. No FairPlay function is provided: the point is that fairplayd stays
+ * up and answers (with errors), and the log shows what it asks the driver for.
+ * Published at boot from AppleCLCD::start; boot-arg sweetfairplay=0 off.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <pexpert/pexpert.h>
+#include <kern/task.h>
+#include <sys/proc.h>
+
+class com_apple_driver_FairPlayIOKit : public IOService {
+	OSDeclareDefaultStructors(com_apple_driver_FairPlayIOKit);
+};
+
+OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKit, IOService);
+
+static uint32_t sweet_fp_logged;
+
+class SweetFairPlayUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetFairPlayUserClient);
+	char fName[32];
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE
+	{
+		if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+			return false;
+		}
+		proc_t p = (proc_t)get_bsdtask_info(owningTask);
+		strlcpy(fName, "?", sizeof(fName));
+		if (p != NULL) {
+			proc_name(proc_pid(p), fName, sizeof(fName));
+		}
+		IOLog("SWEET FAIRPLAY: %s opened the user client (type %u)\n", fName, (unsigned)type);
+		return true;
+	}
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE
+	{
+		terminate();
+		return kIOReturnSuccess;
+	}
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *a, IOExternalMethodDispatch *dispatch,
+	    OSObject *target, void *reference) APPLE_KEXT_OVERRIDE
+	{
+		(void)dispatch;
+		(void)target;
+		(void)reference;
+		if (sweet_fp_logged++ < 200) {
+			IOLog("SWEET FAIRPLAY: %s sel %u scalars in %u out %u, struct in %u out %u%s\n", fName, selector,
+			    a->scalarInputCount, a->scalarOutputCount, a->structureInputSize, a->structureOutputSize,
+			    a->structureInputDescriptor || a->structureOutputDescriptor ? " (descriptor)" : "");
+		}
+		return kIOReturnUnsupported;
+	}
+};
+
+OSDefineMetaClassAndStructors(SweetFairPlayUserClient, IOUserClient);
+
+extern "C" void
+sweet_fairplay_publish(IOService *parent)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("sweetfairplay", &on, sizeof(on));
+	if (!on || parent == NULL) {
+		return;
+	}
+	com_apple_driver_FairPlayIOKit *fp = OSTypeAlloc(com_apple_driver_FairPlayIOKit);
+	if (fp != NULL && fp->init()) {
+		fp->setProperty(kIOUserClientClassKey, "SweetFairPlayUserClient");
+		if (fp->attach(parent)) {
+			fp->registerService();
+			IOLog("SWEET FAIRPLAY: com_apple_driver_FairPlayIOKit stand-in published\n");
+		}
+	}
+	OSSafeReleaseNULL(fp);
+}
+#else
+class IOService;
+extern "C" void sweet_fairplay_publish(IOService *) {}
+#endif
