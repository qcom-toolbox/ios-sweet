From b2aa2c0dbf4c51bba40c51d59da95011c6e96e2f Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Sun, 25 Oct 2026 15:39:27 +0100
Subject: [PATCH] umi-0156

---
 iokit/Kernel/arm/SweetFairPlay.cpp | 39 +++++++++++++++++++++++++++---
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFairPlay.cpp b/iokit/Kernel/arm/SweetFairPlay.cpp
index 7f03077..8d6b2a6 100644
--- a/iokit/Kernel/arm/SweetFairPlay.cpp
+++ b/iokit/Kernel/arm/SweetFairPlay.cpp
@@ -13,6 +13,12 @@
  * kIOReturnUnsupported. No FairPlay function is provided: the point is that fairplayd stays
  * up and answers (with errors), and the log shows what it asks the driver for.
  * Published at boot from AppleCLCD::start; boot-arg sweetfairplay=0 off.
+ *
+ * 0156: the 0155 boot showed fairplayd.H2 open type 0, call selectors 22 (struct out 4),
+ * 23 (struct out 4) and 21 (struct in 552, out 552), then exit after the refusals. Now
+ * selectors whose bit is set in boot-arg sweetfairplayok (default all) succeed: scalar and
+ * struct outputs zero-filled, except that a struct output the size of the struct input gets
+ * the input back. The first 32 bytes of each struct input are logged.
  */
 #include <pexpert/arm64/board_config.h>
 
@@ -33,6 +39,7 @@ class com_apple_driver_FairPlayIOKit : public IOService {
 OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKit, IOService);
 
 static uint32_t sweet_fp_logged;
+static uint64_t sweet_fp_ok = ~0ull;           /* boot-arg sweetfairplayok: selectors that succeed */
 
 class SweetFairPlayUserClient : public IOUserClient {
 	OSDeclareDefaultStructors(SweetFairPlayUserClient);
@@ -62,12 +69,37 @@ public:
 		(void)dispatch;
 		(void)target;
 		(void)reference;
+		bool ok = selector < 64 && (sweet_fp_ok >> selector) & 1;
 		if (sweet_fp_logged++ < 200) {
-			IOLog("SWEET FAIRPLAY: %s sel %u scalars in %u out %u, struct in %u out %u%s\n", fName, selector,
+			IOLog("SWEET FAIRPLAY: %s sel %u scalars in %u out %u, struct in %u out %u%s -> %s\n", fName, selector,
 			    a->scalarInputCount, a->scalarOutputCount, a->structureInputSize, a->structureOutputSize,
-			    a->structureInputDescriptor || a->structureOutputDescriptor ? " (descriptor)" : "");
+			    a->structureInputDescriptor || a->structureOutputDescriptor ? " (descriptor)" : "",
+			    ok ? "ok" : "unsupported");
+			if (a->structureInput != NULL && a->structureInputSize > 0) {
+				const uint8_t *in = (const uint8_t *)a->structureInput;
+				char hex[3 * 32 + 1];
+				uint32_t n = a->structureInputSize < 32 ? a->structureInputSize : 32;
+				for (uint32_t i = 0; i < n; i++) {
+					snprintf(hex + 3 * i, 4, "%02x ", in[i]);
+				}
+				hex[3 * n] = 0;
+				IOLog("SWEET FAIRPLAY:   in %s\n", hex);
+			}
+		}
+		if (!ok) {
+			return kIOReturnUnsupported;
+		}
+		for (uint32_t i = 0; i < a->scalarOutputCount; i++) {
+			a->scalarOutput[i] = 0;
 		}
-		return kIOReturnUnsupported;
+		if (a->structureOutput != NULL && a->structureOutputSize > 0) {
+			if (a->structureInput != NULL && a->structureInputSize == a->structureOutputSize) {
+				memcpy(a->structureOutput, a->structureInput, a->structureOutputSize);
+			} else {
+				bzero(a->structureOutput, a->structureOutputSize);
+			}
+		}
+		return kIOReturnSuccess;
 	}
 };
 
@@ -78,6 +110,7 @@ sweet_fairplay_publish(IOService *parent)
 {
 	uint32_t on = 1;
 	(void)PE_parse_boot_argn("sweetfairplay", &on, sizeof(on));
+	(void)PE_parse_boot_argn("sweetfairplayok", &sweet_fp_ok, sizeof(sweet_fp_ok));
 	if (!on || parent == NULL) {
 		return;
 	}
-- 
